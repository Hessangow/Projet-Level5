<!DOCTYPE html>
<html>
 <head>
  <meta charset="utf-8">
  <title>LEVEL5 - Inscription</title>
 </head>
 <body>
  <h1>LEVEL5</h1>
  <p>Créer un compte</p>

  <% if (erreur) { %>
  <p style="color: red"><%= erreur %></p>
  <% } %>

  <form action="/inscription" method="post">
   Nom : <input type="text" name="nom" required minlength="3" maxlength="30" autocomplete="username" />
   Mot de passe (8 caractères minimum) : <input type="password" name="mdp" required minlength="8" maxlength="72" autocomplete="new-password" />
   <button type="submit">Créer mon compte</button>
  </form>

  <p><a href="/connexion">J'ai déjà un compte</a></p>
 </body>
</html>
